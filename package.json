{
  "name": "@johnmorrisdotca/koyomi-calendars",
  "version": "0.3.0",
  "description": "Koyomi 暦: calendar-page icons as SVG, 18 original designs in light and dark, in any language through Intl. No image, no font, no dependency; import one design alone for a few kilobytes.",
  "keywords": [
    "calendar",
    "calendar-icon",
    "date-icon",
    "icons",
    "svg",
    "svg-icons",
    "dark-mode",
    "intl",
    "localization",
    "japanese",
    "typescript",
    "zero-dependencies",
    "tree-shakable",
    "itsutsu"
  ],
  "homepage": "https://johnmorrisdotca.github.io/koyomi-calendars/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnmorrisdotca/koyomi-calendars.git"
  },
  "bugs": {
    "url": "https://github.com/johnmorrisdotca/koyomi-calendars/issues"
  },
  "author": "John Morris",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
